DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseekv4-flash
FAB_DATABASE_PATH=data/fab_history.db
FAB_DATABASE_DIR=data/departments
FAB_SIMULATION_END_DATE=2026-12-25
AGENT_LOG_PATH=logs/agent_events.jsonl
AGENT_RUN_LOG_DIR=logs/agent
AGENT_LOG_MAX_BYTES=5242880
AGENT_LOG_BACKUP_COUNT=5
AGENT_LOG_CONTENT=metadata
# Full content is test-only: all three settings are required. Expiry must be
# timezone-aware ISO-8601 and no later than 24 hours after service start.
# AGENT_LOG_CONTENT=full
# AGENT_LOG_FULL_TEST_MODE=true
# AGENT_LOG_FULL_EXPIRES_AT=<replace-with-timezone-aware-ISO-8601-UTC-timestamp>
# Total contextualization deadline across protocol correction and network retries; 1000-60000 ms.
MODEL_CONTEXT_TIMEOUT_MS=15000
FAB_ENTERPRISE_MODE=true
FAB_DATA_PROVIDER=synthetic
FAB_DEFAULT_TENANT_ID=demo-fab
FAB_DEFAULT_USER_ID=local-user
FAB_REQUIRE_IDENTITY=false
FAB_MOCK_SEED=20260717
FAB_MOCK_VIRTUAL_LOTS=25000000
FAB_MOCK_CURSOR_SECRET=replace-with-a-long-random-secret
FAB_ADMIN_API_TOKEN=replace-with-a-long-random-admin-token
# Pre-publication probes; bounded to 1-60 seconds and 1024-65536 characters.
MODEL_COMPATIBILITY_TIMEOUT_SECONDS=12
MODEL_COMPATIBILITY_CONTEXT_CHARS=32768
# Passive circuit breaker: only real requests update health; no background probes.
MODEL_CIRCUIT_FAILURE_THRESHOLD=3
MODEL_CIRCUIT_COOLDOWN_SECONDS=60
MODEL_CIRCUIT_RECOVERY_LEASE_SECONDS=120
