# 本地模型接入模板：复制为 .env 后按需修改（.env 已被 .gitignore 忽略）
# 详见 docs/local-qwen3.md

FAB_MODEL_PROVIDER=openai-compatible
FAB_MODEL_BASE_URL=http://127.0.0.1:8080/v1
FAB_MODEL_NAME=Qwen3.8-27B-Q4_K_M
# 本地 llama-server 不校验密钥，但必须非空，否则 /api/health 会报 agent_configured=false
FAB_MODEL_API_KEY=local

# 管理端令牌（发布本地模型、查看运行记录时使用）
FAB_ADMIN_API_TOKEN=local-admin-token

# 本地 27B 首 token 较慢，放宽超时
API_TIMEOUT_MS=120000
MODEL_CONTEXT_TIMEOUT_MS=30000

# 兼容性探针：默认 12 秒对本地 27B 偏紧（tool/context 子探针合计约 18 秒），上限 60。
MODEL_COMPATIBILITY_TIMEOUT_SECONDS=60
MODEL_COMPATIBILITY_CONTEXT_CHARS=32768

# Qwen 模板要求 system 消息必须在最前；Agent 会在历史/证据之后追加 system 指令，
# 开启后会把所有 system 合并为一条前置消息（llama.cpp --jinja 必需）。
FAB_CHAT_TEMPLATE_COMPAT=merge-system
