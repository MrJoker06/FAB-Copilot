                "LITHO",
                "ETCH",
                "CVD",
                "PVD",
                "DIFFUSION",
                "IMPLANT",
                "CMP",
                "CLEAN",
                "METROLOGY"
              ]
            },
            "equipment_id": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      }
    },
    {
