    {
      "type": "function",
      "function": {
        "name": "submit_analysis",
        "description": "提交最终结构化分析。它不是数据工具，不得包含隐藏思维链；只提交面向用户的事实、推断、假设、建议、限制和引用。",
        "parameters": {
          "type": "object",
          "properties": {
            "analysis_protocol_version": {
              "type": "string",
              "enum": [
                "2.0"
              ],
              "description": "可选。2.0 采用调用级直接事实和基于事实索引的综合推断；省略时按旧协议兼容处理。"
            },
            "presentation": {
              "type": "string",
              "enum": [
                "brief",
                "compact",
                "report",
                "table"
              ],
              "description": "可选。输出格式：brief=只给结论；compact=默认分条；table=横向对比表；report=完整分节报告。按用户意图与证据量选择。"
            },
            "conclusion": {
              "type": "string",
              "maxLength": 600
            },
            "conclusion_evidence_refs": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string"
              }
            },
            "conclusion_claim": {
              "type": "object",
              "properties": {
                "claim_kind": {
                  "type": "string",
                  "enum": [
                    "metric",
                    "record",
                    "event",
                    "document",
                    "sample"
                  ]
                },
                "semantic_id": {
                  "type": "string"
                },
                "scope": {
                  "type": "object"
                },
                "grain": {
                  "type": "string"
                },
                "time_range": {
                  "type": "object"
                },
                "claim_role": {
                  "type": "string",
                  "enum": [
                    "primary",
                    "background"
                  ]
                },
                "inference_indices": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 5,
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "additionalProperties": false
            },
            "facts": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "properties": {
                  "statement": {
                    "type": "string"
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "claim_kind": {
                    "type": "string",
                    "enum": [
                      "metric",
                      "record",
                      "event",
                      "document",
                      "sample"
                    ]
                  },
                  "semantic_id": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "object"
                  },
                  "time_range": {
                    "type": "object"
                  },
                  "grain": {
                    "type": "string"
                  },
                  "claim_role": {
                    "type": "string",
                    "enum": [
                      "primary",
                      "background"
                    ]
                  }
                },
                "required": [
                  "statement",
                  "evidence_refs"
                ],
                "additionalProperties": false
              }
            },
            "inferences": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "properties": {
                  "statement": {
                    "type": "string"
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "fact_indices": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "basis": {
                    "type": "string",
                    "maxLength": 500,
                    "description": "面向用户的简短依据，不得包含隐藏思维链。"
                  },
                  "uncertainty": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "claim_kind": {
                    "type": "string",
                    "enum": [
                      "metric",
                      "record",
                      "event",
                      "document",
                      "sample"
                    ]
                  },
                  "semantic_id": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "object"
                  },
                  "time_range": {
                    "type": "object"
                  },
                  "grain": {
                    "type": "string"
                  },
                  "claim_role": {
                    "type": "string",
                    "enum": [
                      "primary",
                      "background"
                    ]
                  }
                },
                "required": [
                  "statement"
                ],
                "additionalProperties": false
              }
            },
            "hypotheses": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "properties": {
                  "statement": {
                    "type": "string"
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "verification": {
                    "type": "string"
                  },
                  "claim_kind": {
                    "type": "string",
                    "enum": [
                      "metric",
                      "record",
                      "event",
                      "document",
                      "sample"
                    ]
                  },
                  "semantic_id": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "object"
                  },
                  "time_range": {
                    "type": "object"
                  },
                  "grain": {
                    "type": "string"
                  },
                  "claim_role": {
                    "type": "string",
                    "enum": [
                      "primary",
                      "background"
                    ]
                  }
                },
                "required": [
                  "statement",
                  "evidence_refs",
                  "verification"
                ],
                "additionalProperties": false
              }
            },
            "recommendations": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string"
                  },
                  "rationale": {
                    "type": "string"
                  },
                  "requires_review": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "action",
                  "rationale",
                  "requires_review"
                ],
                "additionalProperties": false
              }
            },
            "limitations": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "string"
              }
            },
            "source_refs": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "conclusion",
            "conclusion_evidence_refs",
            "conclusion_claim",
            "facts",
            "inferences",
            "hypotheses",
            "recommendations",
            "limitations",
            "source_refs"
          ],
          "additionalProperties": false
        }
      }
    }
  ]
