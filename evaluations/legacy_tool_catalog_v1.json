                "IMPLANT",
                "CMP",
                "CLEAN",
                "METROLOGY"
              ]
            },
            "equipment_id": {
              "type": "string"
            },
            "product": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "Completed",
                "Running",
                "Hold"
              ]
            },
            "signal_name": {
              "type": "string"
            }
