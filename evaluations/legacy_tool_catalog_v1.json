    {
      "type": "function",
      "function": {
        "name": "search_knowledge",
        "description": "联合检索当前用户个人知识、厂内SOP、控制计划、分析方法与已验证历史案例。支持中英文制程术语召回，可按元数据过滤，返回可解释评分和reference_id",
        "parameters": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "process_step": {
              "type": "string",
              "enum": [
